# Copy to .env and fill in. Never commit the real .env (it is already
# .gitignore'd by convention on this project — double check before pushing).
#
# Nothing here is required for `docker compose up` to boot: the backend
# degrades gracefully with no Neo4j and no Gemini key (CLAUDE.md — kb.py-style
# static fallback everywhere). Set these to get the live paths instead of the
# golden-path cache.

# --- Neo4j -------------------------------------------------------------
# Local docker-compose default. For AuraDB, use the neo4j+s:// URI AuraDB
# gives you on instance creation (TLS) — see docs/deploy.md.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=sanjeevani123

# --- OpenRouter (active LLM provider — extraction/attribution) -------------
# Required for live LLM calls. Without it, every LLM call falls back to
# backend/app/providers/golden_path.json (source: "golden_path_cache").
# Get a key at https://openrouter.ai/keys.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Not used for STT by default — see the Local Whisper section below.
# openai/gpt-audio-mini and openai/gpt-audio (OpenRouter's audio-capable chat
# models; it has none literally named "Whisper") both hallucinated fake
# transcripts on silence in live testing — unsafe for medical transcription.
OPENROUTER_STT_MODEL=
OPENROUTER_BASE_URL=

# --- Local Whisper (active STT provider — transcription) -------------------
# faster-whisper, runs fully offline. No API key needed. A dedicated ASR
# model, not a generative one, so it doesn't hallucinate plausible content
# the way the LLM-based STT options above did in testing.
WHISPER_MODEL_SIZE=
WHISPER_DEVICE=
WHISPER_COMPUTE_TYPE=

# --- Anthropic (alternate provider, not active) -----------------------------
# app/api/consult.py currently instantiates OpenRouterLLM + FasterWhisperSTT.
# AnthropicLLM/GeminiLLM/GeminiSTT/OpenRouterSTT implement the same Protocol
# seam and are a straight swap back in consult.py if needed. Anthropic's API
# has no audio-input modality, so it can never back STT.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=

# --- Gemini (alternate provider, not active) --------------------------------
# Also hallucinated fake transcripts on silence in live testing — see above.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_STT_MODEL=

# --- Demo hardening --------------------------------------------------------
# Set to "true" to force EVERY provider call (STT + LLM) to serve from the
# golden-path cache without even attempting a live call — "no network at all"
# contingency mode. See docs/demo.md.
SANJEEVANI_FIXTURE_MODE=false

# --- Frontend --------------------------------------------------------------
# Base URL the frontend calls for the API. docker-compose sets this to
# http://localhost:8000 for you; set it to the deployed Render URL when
# building the frontend for Vercel.
VITE_API_BASE_URL=http://localhost:8000
