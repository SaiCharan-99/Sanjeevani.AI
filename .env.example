# Copy to .env and fill in. Never commit the real .env (it is already
# .gitignore'd by convention on this project — double check before pushing).
#
# Nothing here is required for `docker compose up` to boot: the backend
# degrades gracefully with no Neo4j and no Gemini key (CLAUDE.md — kb.py-style
# static fallback everywhere). Set these to get the live paths instead of the
# golden-path cache.

# --- Neo4j -------------------------------------------------------------
# Local docker-compose default. For AuraDB, use the neo4j+s:// URI AuraDB
# gives you on instance creation (TLS) — see docs/deploy.md.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=sanjeevani123

# --- Gemini --------------------------------------------------------------
# Required for live STT/LLM calls. Without it, every provider call falls back
# to backend/app/providers/golden_path.json (source: "golden_path_cache").
GEMINI_API_KEY=
# Optional overrides — defaults are gemini-3.6-flash for both.
GEMINI_MODEL=
GEMINI_STT_MODEL=

# --- Demo hardening --------------------------------------------------------
# Set to "true" to force EVERY provider call (STT + LLM) to serve from the
# golden-path cache without even attempting a live call — "no network at all"
# contingency mode. See docs/demo.md.
SANJEEVANI_FIXTURE_MODE=false

# --- Frontend --------------------------------------------------------------
# Base URL the frontend calls for the API. docker-compose sets this to
# http://localhost:8000 for you; set it to the deployed Render URL when
# building the frontend for Vercel.
VITE_API_BASE_URL=http://localhost:8000
